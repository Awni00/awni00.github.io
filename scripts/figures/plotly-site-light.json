{
  "layout": {
    "font": {
      "family": "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif",
      "size": 13,
      "color": "#2b2c30"
    },
    "paper_bgcolor": "rgba(0,0,0,0)",
    "plot_bgcolor": "rgba(0,0,0,0)",
    "colorway": [
      "#902343",
      "#2e64a6",
      "#c0851f",
      "#109488",
      "#7b52a4",
      "#6c9539"
    ],
    "title": {
      "font": {
        "size": 13,
        "color": "#2b2c30"
      },
      "x": 0,
      "xanchor": "left",
      "xref": "paper"
    },
    "xaxis": {
      "showgrid": false,
      "gridcolor": "#e8e6e0",
      "gridwidth": 1,
      "zeroline": false,
      "showline": true,
      "linecolor": "#d8d6d0",
      "linewidth": 1,
      "ticks": "outside",
      "ticklen": 4,
      "tickwidth": 1,
      "tickcolor": "#d8d6d0",
      "tickfont": {
        "size": 12,
        "color": "#6b6d72"
      },
      "title": {
        "font": {
          "size": 13,
          "color": "#2b2c30"
        },
        "standoff": 8
      },
      "automargin": true
    },
    "yaxis": {
      "showgrid": true,
      "gridcolor": "#e8e6e0",
      "gridwidth": 1,
      "zeroline": false,
      "showline": false,
      "linecolor": "#d8d6d0",
      "linewidth": 1,
      "ticks": "",
      "ticklen": 0,
      "tickwidth": 1,
      "tickcolor": "#d8d6d0",
      "tickfont": {
        "size": 12,
        "color": "#6b6d72"
      },
      "title": {
        "font": {
          "size": 13,
          "color": "#2b2c30"
        },
        "standoff": 8
      },
      "automargin": true
    },
    "legend": {
      "orientation": "h",
      "x": 0,
      "xanchor": "left",
      "y": 1.02,
      "yanchor": "bottom",
      "bgcolor": "rgba(0,0,0,0)",
      "borderwidth": 0,
      "font": {
        "size": 12,
        "color": "#2b2c30"
      },
      "title": {
        "text": ""
      },
      "itemwidth": 30,
      "tracegroupgap": 0
    },
    "margin": {
      "t": 40,
      "r": 8,
      "b": 44,
      "l": 52,
      "pad": 0
    },
    "bargap": 0.28,
    "bargroupgap": 0.08,
    "hoverlabel": {
      "bgcolor": "#ffffff",
      "bordercolor": "#e8e6e0",
      "font": {
        "family": "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif",
        "size": 12,
        "color": "#2b2c30"
      }
    },
    "hovermode": "closest",
    "annotationdefaults": {
      "font": {
        "size": 12,
        "color": "#2b2c30"
      },
      "showarrow": false
    },
    "colorscale": {
      "sequential": [
        [
          0,
          "#f3e9ec"
        ],
        [
          0.5,
          "#c4627c"
        ],
        [
          1,
          "#5a0f27"
        ]
      ]
    },
    "meta": {
      "neutral": "#8e9095",
      "draft": "F1 figure spec, not wired in"
    }
  },
  "data": {
    "scatter": [
      {
        "type": "scatter",
        "line": {
          "width": 2
        },
        "marker": {
          "size": 7,
          "line": {
            "width": 0
          }
        }
      }
    ],
    "bar": [
      {
        "type": "bar",
        "marker": {
          "line": {
            "width": 0
          }
        },
        "error_y": {
          "thickness": 1,
          "width": 0
        }
      }
    ]
  }
}