@article{altabaa2025unlockingoutofdistributiongeneralizationtransformers,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {ML},
  title        = {Unlocking Out-of-Distribution Generalization in Transformers via Recursive Latent Space Reasoning},
  author       = {Awni Altabaa and Siyu Chen and John Lafferty and Zhuoran Yang},
  year         = {2025},
  journal      = {Under review},
  eprint       = {2510.14095},
  arxiv        = {2510.14095},
  archiveprefix = {arXiv},
  primaryclass = {cs.LG},
  url          = {https://arxiv.org/abs/2510.14095},
  code         = {https://github.com/Awni00/algorithmic-generalization-transformer-architectures},
  blog         = {https://awni.xyz/algorithmic-generalization-transformer-architectures},
  preview      = {mechanisms-generalization.png},
  tldr         = {We introduce and explore a set of four architectural mechanisms aimed at enhancing out-of-distribution algorithmic generalization: input-adaptive recurrence, algorithmic supervision, anchored latent representations via a discrete bottleneck, and an explicit error-correction mechanism.},
  abstract     = {Systematic, compositional generalization beyond the training distribution remains a core challenge in machine learning -- and a critical bottleneck for the emergent reasoning abilities of modern language models. This work investigates out-of-distribution (OOD) generalization in Transformer networks using a GSM8K-style modular arithmetic on computational graphs task as a testbed. We introduce and explore a set of four architectural mechanisms aimed at enhancing OOD generalization: (i) input-adaptive recurrence; (ii) algorithmic supervision; (iii) anchored latent representations via a discrete bottleneck; and (iv) an explicit error-correction mechanism. Collectively, these mechanisms yield an architectural approach for native and scalable latent space reasoning in Transformer networks with robust algorithmic generalization capabilities. We complement these empirical results with a detailed mechanistic interpretability analysis that reveals how these mechanisms give rise to robust OOD generalization abilities.}
}

@article{altabaa2025cotinformation,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {ML},
  title        = {CoT Information: Improved Sample Complexity under Chain-of-Thought Supervision},
  author       = {Awni Altabaa and Omar Montasser and John Lafferty},
  year         = {2025},
  journal      = {Neural Information Processing Systems (NeurIPS), spotlight},
  eprint       = {2505.15927},
  arxiv        = {2505.15927},
  archiveprefix = {arXiv},
  primaryclass = {stat.ML},
  url          = {https://arxiv.org/abs/2505.15927},
  blog         = {https://awni.xyz/cot-info},
  poster       = {/publications/posters/cotinfo-poster.pdf},
  slides       = {/publications/slides/cotinfo-slides.pdf},
  preview      = {cot-information.png},
  tldr         = {We develop a statistical theory of learning under chain-of-thought supervision, introducing the CoT information measure to quantify the additional discriminative power gained from observing the reasoning process.},
  abstract     = {Learning complex functions that involve multi-step reasoning poses a significant challenge for standard supervised learning from input-output examples. Chain-of-thought (CoT) supervision, which provides intermediate reasoning steps together with the final output, has emerged as a powerful empirical technique, underpinning much of the recent progress in the reasoning capabilities of large language models. This paper develops a statistical theory of learning under CoT supervision. A key characteristic of the CoT setting, in contrast to standard supervision, is the mismatch between the training objective (CoT risk) and the test objective (end-to-end risk). A central part of our analysis, distinguished from prior work, is explicitly linking those two types of risk to achieve sharper sample complexity bounds. This is achieved via the CoT information measure, which quantifies the additional discriminative power gained from observing the reasoning process. The main theoretical results demonstrate how CoT supervision can yield significantly faster learning rates compared to standard E2E supervision.}
}

@article{altabaa2024disentangling,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {ML},
  title        = {Disentangling and Integrating Relational and Sensory Information in Transformer Architectures},
  author       = {Awni Altabaa and John Lafferty},
  year         = {2025},
  journal      = {International Conference on Machine Learning (ICML)},
  eprint       = {2405.16727},
  arxiv        = {2405.16727},
  archiveprefix = {arXiv},
  primaryclass = {cs.LG},
  url          = {https://arxiv.org/abs/2405.16727},
  website      = {https://icml.cc/virtual/2025/poster/44191},
  blog         = {https://awni.xyz/dual-attention},
  code         = {https://github.com/awni00/dual-attention},
  slides       = {/publications/slides/dat-slides.pdf},
  poster       = {/publications/posters/dat-poster.pdf},
  preview      = {disentangling-sensory-relational.png},
  tldr         = {We introduce the Dual Attention Transformer, an architectural extension of the Transformer framework that incorporates distinct sensory and relational attention mechanisms.},
  abstract     = {Relational reasoning is a central component of generally intelligent systems, enabling robust and data-efficient inductive generalization. Recent empirical evidence shows that many existing neural architectures, including Transformers, struggle with tasks requiring relational reasoning. In this work, we distinguish between two types of information: sensory information about the properties of individual objects, and relational information about the relationships between objects. While neural attention provides a powerful mechanism for controlling the flow of sensory information between objects, the Transformer lacks an explicit computational mechanism for routing and processing relational information. To address this limitation, we propose an architectural extension of the Transformer framework that we call the Dual Attention Transformer (DAT), featuring two distinct attention mechanisms: sensory attention for directing the flow of sensory information, and a novel relational attention mechanism for directing the flow of relational information.}
}

@article{altabaaRoleInformationStructure2024,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {RL},
  title        = {On the Role of Information Structure in Reinforcement Learning for Partially-Observable Sequential Teams and Games},
  author       = {Altabaa, Awni and Yang, Zhuoran},
  year         = {2024},
  journal      = {Neural Information Processing Systems (NeurIPS)},
  eprint       = {2403.00993},
  arxiv        = {2403.00993},
  archiveprefix = {arXiv},
  primaryclass = {cs, stat},
  doi          = {10.48550/arXiv.2403.00993},
  url          = {https://arxiv.org/abs/2403.00993},
  website      = {https://neurips.cc/virtual/2024/poster/95220},
  slides       = {/publications/slides/rl-info-struct-slides.pdf},
  poster       = {/publications/posters/rl-info-struct-poster.pdf},
  preview      = {info-structure.png},
  tldr         = {We introduce a reinforcement learning model that explicitly represents information structure in sequential decision-making problems.},
  abstract     = {In sequential decision-making problems, the information structure describes the causal dependencies between system variables, encompassing the dynamics of the environment and the agents' actions. Classical models of reinforcement learning assume a restricted and highly regular information structure, while more general models like predictive state representations do not explicitly model the information structure. By contrast, real-world sequential decision-making problems typically involve a complex and time-varying interdependence of system variables, requiring a rich and flexible representation of information structure. In this paper, we formalize a novel reinforcement learning model which explicitly represents the information structure.}
}

@article{altabaaApproximationRelationFunctions2024,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {ML},
  title        = {Approximation of Relation Functions and Attention Mechanisms},
  author       = {Altabaa, Awni and Lafferty, John},
  year         = {2024},
  journal      = {Information Theory, Probability and Statistical Learning: A Festschrift in Honor of Andrew Barron},
  eprint       = {2402.08856},
  arxiv        = {2402.08856},
  archiveprefix = {arXiv},
  primaryclass = {cs, stat},
  doi          = {10.48550/arXiv.2402.08856},
  url          = {https://arxiv.org/abs/2402.08856},
  preview      = {rel-approx.png},
  tldr         = {We show that inner products of neural network feature maps can approximate symmetric and asymmetric relation functions, with applications to attention.},
  abstract     = {Inner products of neural network feature maps arises in a wide variety of machine learning frameworks as a method of modeling relations between inputs. This work studies the approximation properties of inner products of neural networks. It is shown that the inner product of a multi-layer perceptron with itself is a universal approximator for symmetric positive-definite relation functions. In the case of asymmetric relation functions, it is shown that the inner product of two different multi-layer perceptrons is a universal approximator. Finally, these approximation results are applied to analyzing the attention mechanism underlying Transformers.}
}

@article{altabaaRelationalConvolutionalNetworks2023,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {ML},
  title        = {Learning Hierarchical Relational Representations through Relational Convolutions},
  author       = {Awni Altabaa and John Lafferty},
  year         = {2024},
  journal      = {Transactions on Machine Learning Research (TMLR)},
  eprint       = {2310.03240},
  arxiv        = {2310.03240},
  archiveprefix = {arXiv},
  primaryclass = {cs.LG},
  url          = {https://arxiv.org/abs/2310.03240},
  website      = {https://openreview.net/forum?id=vNZlnznmV2},
  blog         = {https://awni.xyz/relational-convolutions},
  code         = {https://github.com/awni00/relational-convolutions},
  preview      = {relconv-genai.png},
  tldr         = {We introduce relational convolutional networks, a neural architecture for hierarchical relational feature representations.},
  abstract     = {An evolving area of research in deep learning is the study of architectures and inductive biases that support the learning of relational feature representations. In this paper, we address the challenge of learning representations of hierarchical relations--that is, higher-order relational patterns among groups of objects. We introduce relational convolutional networks, a neural architecture equipped with computational mechanisms that capture progressively more complex relational features through the composition of simple modules.}
}

@article{webbRelationalBottleneckInductive2023,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {Neuro/ML},
  title        = {The Relational Bottleneck as an Inductive Bias for Efficient Abstraction},
  author       = {Webb, Taylor W. and Frankland, Steven M. and Altabaa, Awni and Krishnamurthy, Kamesh and Campbell, Declan and Russin, Jacob and O'Reilly, Randall and Lafferty, John and Cohen, Jonathan D.},
  year         = {2024},
  journal      = {Trends in Cognitive Science (TICS)},
  url          = {https://www.cell.com/trends/cognitive-sciences/fulltext/S1364-6613(24)00080-9},
  website      = {https://www.cell.com/trends/cognitive-sciences/fulltext/S1364-6613(24)00080-9},
  preview      = {relational-bottleneck.png},
  tldr         = {We review relational bottleneck models as an inductive bias for data-efficient abstraction in minds and machines.},
  abstract     = {A central challenge for cognitive science is to explain how abstract concepts are acquired from limited experience. Here, we highlight a recently emerging line of work that suggests a novel reconciliation of empiricist and nativist approaches, by exploiting an inductive bias that we term the relational bottleneck. We review a family of models that employ this approach to induce abstractions in a data-efficient manner, emphasizing their potential as candidate models for the acquisition of abstract concepts in the human mind and brain.}
}

@article{altabaaAbstractorsRelationalCrossattention2023,
  selected     = {true},
  bibtex_show  = {true},
  abbr         = {ML},
  title        = {Abstractors and Relational Cross-Attention: An Inductive Bias for Explicit Relational Reasoning in Transformers},
  author       = {Altabaa, Awni and Webb, Taylor and Cohen, Jonathan and Lafferty, John},
  year         = {2024},
  journal      = {International Conference on Learning Representations (ICLR)},
  eprint       = {2304.00195},
  arxiv        = {2304.00195},
  archiveprefix = {arXiv},
  primaryclass = {cs, stat},
  url          = {https://arxiv.org/abs/2304.00195},
  website      = {https://openreview.net/forum?id=XNa6r6ZjoB},
  blog         = {https://awni.xyz/abstractor},
  code         = {https://github.com/awni00/abstractor},
  slides       = {/publications/slides/abstractor-slides.pdf},
  poster       = {/publications/posters/abstractor-poster.pdf},
  preview      = {abstraction-relational-reasoning.png},
  tldr         = {We introduce the Abstractor, a neural module using relational cross-attention for explicit relational reasoning in Transformers.},
  abstract     = {An extension of Transformers is proposed that enables explicit relational reasoning through a novel module called the Abstractor. At the core of the Abstractor is a variant of attention called relational cross-attention. The approach is motivated by an architectural inductive bias for relational learning that disentangles relational information from extraneous features about individual objects. This enables explicit relational reasoning, supporting abstraction and generalization from limited data.}
}

