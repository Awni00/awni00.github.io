---
type Props = {
  src: string;
  title?: string;
  caption?: string;
  height?: string;
  linkLabel?: string;
};

const {
  src,
  title = "Embedded figure",
  caption,
  height = "520px",
  linkLabel = "Open embedded figure"
} = Astro.props;
const style = `--embed-frame-height: ${height};`;
const hasCaptionSlot = Astro.slots.has("caption");
---

<figure class="article-figure embed-frame" style={style}>
  <iframe class="embed-frame__frame" src={src} title={title} loading="lazy"></iframe>
  <figcaption>
    {
      hasCaptionSlot ? (
        <span>
          <slot name="caption" />
        </span>
      ) : (
        caption && <span>{caption}</span>
      )
    }
    <a href={src}>{linkLabel}</a>
  </figcaption>
</figure>
