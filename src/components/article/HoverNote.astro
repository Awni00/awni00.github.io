---
/**
 * Hover note: a mark in running prose that reveals a small popover on hover,
 * focus, or tap. No footnote is emitted anywhere.
 *
 *   quantum mechanics<HoverNote href="https://arxiv.org/abs/…">*Paper title*, NeurIPS 2024</HoverNote>
 *   attention<HoverNote cite="vaswani2017attention" />
 *
 * Props:
 *   - `mark`       — the mark's text. In MDX, omit it and `remarkHoverNotes`
 *                    numbers the note (per page; a repeated `cite` reuses its
 *                    number).
 *   - `href`       — makes the mark itself a link. On touch screens the first
 *                    tap opens the note and the link sits in its footer.
 *   - `cite`       — a BibTeX key, looked up in the page's `bibliography:`
 *                    files and then the publications file. Fills in title,
 *                    authors, venue and year, and the entry's first link as
 *                    `href` unless one is given. Children, if any, follow it.
 *   - `text`       — plain-text content, for when children are awkward.
 *   - `marker`     — "superscript" or "bracket" (`[1]` on the line).
 *   - `appearance` — "card" or "inverted".
 *   - children     — the note content. Keep it on one line in MDX so it parses
 *                    as inline markdown (italics, links, math); a blank line
 *                    would make paragraphs, which cannot sit inside a sentence.
 *
 * `marker` and `appearance` cascade: `theme.hoverNotes` in the site config
 * (superscript card by default), then a page's `hoverNotes:` frontmatter
 * (applied by `remarkHoverNotes`), then the note's own props.
 */
import { themeConfig, type HoverNoteAppearance, type HoverNoteMarker } from "../../config/theme";
import { resolveCitation } from "../../lib/citations/citations";

type Props = {
  mark?: string;
  href?: string;
  cite?: string;
  text?: string;
  marker?: HoverNoteMarker;
  appearance?: HoverNoteAppearance;
  /** Set by `remarkHoverNotes` from frontmatter: JSON array of absolute paths. */
  bibliography?: string;
};

const {
  mark,
  cite,
  text,
  marker = themeConfig.hoverNotes.marker,
  appearance = themeConfig.hoverNotes.appearance,
  bibliography
} = Astro.props;
let { href } = Astro.props;

const citation = cite ? await resolveCitation(cite, bibliography ? JSON.parse(bibliography) : []) : undefined;
const citationLink = citation && !href ? citation.link : undefined;
href ??= citationLink?.href;
const hasChildren = Astro.slots.has("default");

const hostname = (() => {
  if (!href) return undefined;
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return undefined;
  }
})();
const isExternal = Boolean(hostname);
// A typed link reads better by its kind ("PDF", "arXiv", "DOI"); a bare URL by
// where it goes.
const linkLabel =
  citationLink && !["URL", "Website"].includes(citationLink.label) ? citationLink.label : (hostname ?? "Open");
const external = isExternal ? { target: "_blank", rel: "noopener" } : {};

const id = `hovernote-${Math.random().toString(36).slice(2, 10)}`;
const MarkTag = href ? "a" : "button";
const markAttrs = href ? { href, ...external } : { type: "button" as const };
---

<span
  class="hovernote"
  data-hovernote
  data-hover-popover
  data-marker={marker}
  data-appearance={appearance}
  data-auto={mark ? undefined : "true"}
  ><sup class="hovernote__sup"
    ><MarkTag class="hovernote__mark" data-hover-trigger aria-describedby={id} {...markAttrs}>{mark}</MarkTag></sup
  ><span class="hovernote__pop hover-pop" id={id} role="tooltip" popover="manual"
    ><span class="hovernote__body"
      >{
        citation && (
          <>
            <span class="hovernote__title">{citation.title}</span>
            {citation.authors && <span class="hovernote__meta">{citation.authors}</span>}
            {(citation.venue || citation.year) && (
              <span class="hovernote__meta">{[citation.venue, citation.year].filter(Boolean).join(" · ")}</span>
            )}
          </>
        )
      }{
        citation ? (
          hasChildren && (
            <span class="hovernote__extra">
              <slot />
            </span>
          )
        ) : text ? (
          text
        ) : (
          <slot />
        )
      }</span
    >{
      href && (
        <a class="hovernote__link" href={href} {...external}>
          {linkLabel}
          <span aria-hidden="true">{isExternal ? "↗" : "→"}</span>
        </a>
      )
    }</span
  ></span
><script>
  import { wireHoverPopovers } from "../../lib/article/hoverPopover";

  const ROOT = "[data-hovernote]";

  // Adjacent marks ("…mechanics¹,²") read as one number without a separator.
  function previousNote(note: HTMLElement) {
    let node = note.previousSibling;
    // Skips whitespace, and the dev server's inline copy of this script.
    while (node && (node.nodeName === "SCRIPT" || (node.nodeType === Node.TEXT_NODE && !node.textContent?.trim()))) {
      node = node.previousSibling;
    }
    return node instanceof HTMLElement && node.matches(ROOT) ? node : null;
  }

  function wireHoverNotes() {
    for (const note of document.querySelectorAll<HTMLElement>(ROOT)) {
      if (note.dataset.hovernoteReady === "true") continue;
      note.dataset.hovernoteReady = "true";
      const previous = previousNote(note);
      if (previous) {
        note.dataset.grouped = "true";
        previous.dataset.continued = "true";
      }
    }
    wireHoverPopovers();
  }

  wireHoverNotes();
  document.addEventListener("astro:page-load", wireHoverNotes);
</script>
