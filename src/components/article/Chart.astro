---
/**
 * A chart drawn at build time from a figure definition and its data.
 *
 *   <Chart figure="abstractor/pairwise-order" caption="…" />
 *
 * `figure` names a definition in `src/site/figures/` (path without `.ts`);
 * the definition names its data file in `src/data/figures/`. The chart is
 * inline SVG, so it uses the page's fonts and recolours with the theme.
 * A `full` chart is also drawn at phone width and swapped in on narrow
 * columns, rather than shrinking its type.
 *
 * Marks with a `title` channel get a hover tooltip. A definition with a
 * sibling `<figure>.client.ts` is interactive: that module mounts when the
 * chart scrolls into view, and the build-time SVG stays as its fallback.
 */
import Figure from "./Figure.astro";
import {
  DASH,
  FIGURE_COMPACT_WIDTH,
  FIGURE_SIZES,
  colorToken,
  type FigureDefinition,
  type FigureSize
} from "../../lib/figures";
import { parseFigureData, renderFigure } from "../../lib/figures/render";
import "../../styles/figures.css";

type Props = {
  figure: string;
  alt?: string;
  caption?: string;
  /** Overrides the definition's size preset. */
  size?: FigureSize;
};

const { figure, alt, caption, size: sizeOverride } = Astro.props;

const definitions = import.meta.glob<{ default: FigureDefinition }>(
  ["/src/site/figures/**/*.ts", "!/src/site/figures/**/*.client.ts"],
  { eager: true }
);
const clients = import.meta.glob("/src/site/figures/**/*.client.ts");
const datasets = import.meta.glob<string>("/src/data/figures/**/*.csv", {
  eager: true,
  query: "?raw",
  import: "default"
});

const definition = definitions[`/src/site/figures/${figure}.ts`]?.default;
if (!definition) throw new Error(`<Chart>: no figure definition at src/site/figures/${figure}.ts`);
const csv = datasets[`/src/data/figures/${definition.data}`];
if (csv === undefined) throw new Error(`<Chart>: no data file at src/data/figures/${definition.data}`);

const data = parseFigureData(csv);
const size = sizeOverride ?? definition.size;
const width = FIGURE_SIZES[size];
const label = alt ?? definition.alt ?? "";
const wide = renderFigure(definition.plot({ data, width, compact: false }), label);
const compact =
  size === "full"
    ? renderFigure(definition.plot({ data, width: FIGURE_COMPACT_WIDTH, compact: true }), label)
    : null;
const interactive = `/src/site/figures/${figure}.client.ts` in clients;
// Rendered here and handed on, because an empty forwarded slot would still
// count as a caption to <Figure> and leave an empty <figcaption>.
const escapeHtml = (text: string) =>
  text.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
const captionHtml = Astro.slots.has("caption")
  ? await Astro.slots.render("caption")
  : caption && escapeHtml(caption);
const legend = definition.legend ?? [];
const mono = (definition.mono ?? []).join(" ");
---

<Figure maxWidth={`${width}px`}>
  <div
    slot="figure"
    class:list={["figure-chart", `figure-chart--${size}`]}
    style={`--figure-width: ${width}px`}
    data-mono={mono || undefined}
    data-figure={figure}
    data-figure-client={interactive ? "" : undefined}
  >
    {definition.title && <p class="figure-chart__title">{definition.title}</p>}
    <div class="figure-chart__plot">
      <div class="figure-chart__wide" set:html={wide} />
      {compact && <div class="figure-chart__compact" set:html={compact} />}
    </div>
    {
      legend.length > 0 && (
        <ul class="figure-legend" aria-hidden="true">
          {legend.map((item) => (
            <li>
              <svg width="16" height="10" viewBox="0 0 16 10">
                {item.key === "line" ? (
                  <line
                    x1="0"
                    x2="16"
                    y1="5"
                    y2="5"
                    stroke={colorToken(item.color)}
                    stroke-width="2"
                    stroke-dasharray={item.dashed ? DASH : undefined}
                  />
                ) : item.key === "dot" ? (
                  <circle cx="8" cy="5" r="4" fill={colorToken(item.color)} />
                ) : (
                  <rect x="3" y="0" width="10" height="10" rx="1.5" fill={colorToken(item.color)} />
                )}
              </svg>
              {item.label}
            </li>
          ))}
        </ul>
      )
    }
    {interactive && <script type="application/json" data-figure-data set:html={JSON.stringify(data)} />}
  </div>
  {captionHtml && <Fragment slot="caption" set:html={captionHtml} />}
</Figure>

<script>
  import type { FigureClient } from "../../lib/figures";

  // Hover: show a mark's <title> in a styled tip instead of the native one,
  // which is slow to appear and missing on touch.
  const tip = document.createElement("div");
  tip.className = "figure-tip";
  tip.hidden = true;
  document.body.append(tip);

  const tipTarget = (node: EventTarget | null) => {
    if (!(node instanceof Element) || !node.closest(".figure-chart")) return null;
    for (let el: Element | null = node; el && !el.classList.contains("figure-chart"); el = el.parentElement) {
      const title = el.querySelector(":scope > title");
      if (title) {
        (el as HTMLElement).dataset.tip = title.textContent ?? "";
        title.remove();
      }
      if ((el as HTMLElement).dataset?.tip) return el as HTMLElement;
    }
    return null;
  };

  const place = (event: PointerEvent) => {
    const gap = 14;
    const { innerWidth } = window;
    const box = tip.getBoundingClientRect();
    const left = Math.min(event.clientX + gap, innerWidth - box.width - 8);
    tip.style.left = `${Math.max(8, left)}px`;
    tip.style.top = `${event.clientY - box.height - gap}px`;
  };

  document.addEventListener("pointerover", (event) => {
    const target = tipTarget(event.target);
    if (!target) return;
    tip.textContent = target.dataset.tip ?? "";
    tip.hidden = false;
    place(event);
  });
  document.addEventListener("pointermove", (event) => {
    if (!tip.hidden) place(event);
  });
  document.addEventListener("pointerout", (event) => {
    if (tipTarget(event.target) && !tipTarget(event.relatedTarget)) tip.hidden = true;
  });
  window.addEventListener("scroll", () => (tip.hidden = true), { passive: true });

  // Interactive figures: mount each client module when its chart is near the
  // viewport, so a page of charts loads no extra code until it's needed.
  const clients = import.meta.glob<{ default: FigureClient }>("/src/site/figures/**/*.client.ts");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const root = entry.target as HTMLElement;
        observer.unobserve(root);
        const load = clients[`/src/site/figures/${root.dataset.figure}.client.ts`];
        if (!load) continue;
        const data = JSON.parse(root.querySelector("script[data-figure-data]")?.textContent ?? "[]");
        load()
          .then((module) => module.default(root, { data }))
          .then(() => root.classList.add("is-interactive"))
          .catch((error) => console.error(`Figure ${root.dataset.figure} failed to mount`, error));
      }
    },
    { rootMargin: "200px" }
  );
  for (const root of document.querySelectorAll<HTMLElement>(".figure-chart[data-figure-client]")) {
    observer.observe(root);
  }
</script>
