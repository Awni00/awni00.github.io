---
import { Picture as AstroPicture } from "astro:assets";

import { isPdfSource, renderPdfFirstPage } from "../../lib/article/pdf";

type Props = {
  src?: string | ImageMetadata;
  alt: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  lightSrc?: string;
  darkSrc?: string;
};

const {
  src,
  alt,
  priority = false,
  invertInDarkMode = false,
  lightSrc,
  darkSrc
} = Astro.props;

const loading = priority ? "eager" : "lazy";
const decoding = priority ? "sync" : "async";
const fetchpriority = priority ? "high" : "auto";
const className = `article-picture${invertInDarkMode ? " invert-in-dark" : ""}`;
const renderedPdf = isPdfSource(src)
  ? await renderPdfFirstPage(src, { emitToDist: import.meta.env.PROD })
  : undefined;
---

{
  lightSrc && darkSrc ? (
    <picture class="article-picture">
      <source srcset={darkSrc} media="(prefers-color-scheme: dark)" />
      <img
        class:list={{ "invert-in-dark": invertInDarkMode }}
        src={lightSrc}
        alt={alt}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    </picture>
  ) : renderedPdf ? (
    <img
      class={className}
      src={renderedPdf.src}
      width={renderedPdf.width}
      height={renderedPdf.height}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  ) : typeof src === "object" ? (
    <AstroPicture
      class={className}
      src={src}
      alt={alt}
      layout="constrained"
      formats={["avif"]}
      priority={priority}
      fit="scale-down"
    />
  ) : (
    <img
      class={className}
      src={src}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  )
}
