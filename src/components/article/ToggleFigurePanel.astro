---
import { buildMediaLayoutStyle, type MediaLayoutProps } from "./mediaLayout";

type Props = {
  label: string;
  value?: string;
  class?: string;
  style?: string;
} & MediaLayoutProps;

const {
  label,
  value,
  class: className,
  style,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;
const panelValue = value ?? label;
const layoutStyle = buildMediaLayoutStyle(
  {
    width,
    maxWidth,
    mediaWidth,
    mediaMaxWidth,
    mediaHeight,
    mediaMaxHeight,
    mediaAspectRatio,
    mediaFit,
    mediaInset,
    mediaAlign
  },
  { style }
);
---

<section
  class:list={["toggle-figure__panel", className]}
  style={layoutStyle}
  data-toggle-figure-panel
  data-label={label}
  data-value={panelValue}
>
  <slot />
</section>
