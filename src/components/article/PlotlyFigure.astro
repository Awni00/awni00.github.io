---
import EmbedFrame from "./EmbedFrame.astro";
import type { MediaLayoutProps } from "./mediaLayout";

type Props = {
  src: string;
  iframeTitle: string;
  caption?: string;
  height?: string;
  linkLabel?: string;
  showOpenLink?: boolean;
  fallbackSrc?: string;
  fallbackAlt?: string;
  loading?: "lazy" | "eager";
  sandbox?: string;
  class?: string;
  style?: string;
} & MediaLayoutProps;

const {
  src,
  iframeTitle,
  caption,
  height = "560px",
  linkLabel = "Open interactive figure",
  showOpenLink = true,
  fallbackSrc,
  fallbackAlt = iframeTitle,
  loading = "lazy",
  sandbox = "allow-scripts allow-same-origin",
  class: className,
  style,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;
const hasCaptionSlot = Astro.slots.has("caption");
const figureClass = ["plotly-figure", className].filter(Boolean).join(" ");
---

  {
    hasCaptionSlot ? (
      <EmbedFrame
        src={src}
        title={iframeTitle}
        height={height}
        linkLabel={linkLabel}
        showOpenLink={showOpenLink}
        loading={loading}
        sandbox={sandbox}
        class={figureClass}
        style={style}
        width={width}
        maxWidth={maxWidth}
        mediaWidth={mediaWidth}
        mediaMaxWidth={mediaMaxWidth}
        mediaHeight={mediaHeight}
        mediaMaxHeight={mediaMaxHeight}
        mediaAspectRatio={mediaAspectRatio}
        mediaFit={mediaFit}
        mediaInset={mediaInset}
        mediaAlign={mediaAlign}
      >
        {
          fallbackSrc && (
            <noscript>
              <img class="plotly-figure__fallback" src={fallbackSrc} alt={fallbackAlt} loading={loading} />
            </noscript>
          )
        }
        <Fragment slot="caption">
          <slot name="caption" />
        </Fragment>
      </EmbedFrame>
    ) : (
      <EmbedFrame
        src={src}
        title={iframeTitle}
        caption={caption}
        height={height}
        linkLabel={linkLabel}
        showOpenLink={showOpenLink}
        loading={loading}
        sandbox={sandbox}
        class={figureClass}
        style={style}
        width={width}
        maxWidth={maxWidth}
        mediaWidth={mediaWidth}
        mediaMaxWidth={mediaMaxWidth}
        mediaHeight={mediaHeight}
        mediaMaxHeight={mediaMaxHeight}
        mediaAspectRatio={mediaAspectRatio}
        mediaFit={mediaFit}
        mediaInset={mediaInset}
        mediaAlign={mediaAlign}
      >
        {
          fallbackSrc && (
            <noscript>
              <img class="plotly-figure__fallback" src={fallbackSrc} alt={fallbackAlt} loading={loading} />
            </noscript>
          )
        }
      </EmbedFrame>
    )
  }
