---
/**
 * Homepage hero, "margin card": the photo, a short caption, and the profile
 * links sit in a card beside the bio column. The bio never wraps around it.
 *
 * The card comes first in the source so that on a phone, where the hero is a
 * plain block, it stacks above the bio. On tablet and desktop the hero is a
 * two-column grid and each child is placed by explicit `grid-column`, which is
 * how `photo.side` mirrors the layout — not `order`, and not floats. See the
 * `.hero` rules in globals.css.
 *
 * Without a photo the card keeps its caption and links and sits above the bio.
 */
import HeroIcon from "./HeroIcon.astro";
import type { HeroConfig } from "../../config/types";
import type { HeroLink } from "../../lib/home/hero";

type Props = {
  hero: HeroConfig;
  name: string;
  role: string;
  affiliation: string;
  /** Path or URL of the photo; empty for none. */
  photo: string;
  links: HeroLink[];
  /** Extra classes for the bio column, e.g. from `justifyClasses`. */
  bioClass?: string[];
};

const { hero, name, role, affiliation, photo, links, bioClass = [] } = Astro.props;
const { side, width, shape, radius, position, sticky } = hero.photo;
const photoRadius = shape === "circle" ? "50%" : shape === "square" ? "0px" : `${radius}px`;
const style = [
  `--hero-photo-w: ${width}px`,
  `--hero-photo-radius: ${photoRadius}`,
  `--hero-photo-position: ${position}`
].join("; ");
---

<section
  class:list={[
    "hero",
    `hero--side-${side}`,
    `hero--phone-${hero.phone.layout}`,
    `hero--links-desktop-${hero.links.style.desktop}`,
    `hero--links-mobile-${hero.links.style.mobile}`,
    { "hero--sticky": sticky, "hero--no-photo": !photo }
  ]}
  style={style}
  data-hero-side={side}
>
  <div class="hero-card">
    {photo && <img class="hero-photo" src={photo} alt={name} width={width} height={width} />}
    <div class="hero-meta">
      <div class="hero-caption">
        <h1 class:list={["hero-name", { "visually-hidden": !hero.caption.showName }]}>{name}</h1>
        {role && <p class="hero-role">{role}</p>}
        {affiliation && <p class="hero-affiliation">{affiliation}</p>}
        {hero.caption.extra.map((line) => <p class="hero-extra">{line}</p>)}
      </div>
      {
        links.length > 0 && (
          <nav class="hero-links" aria-label="Profile links">
            {links.map((link) => (
              <a class="hero-link" href={link.href} title={link.label} data-link-key={link.key}>
                <HeroIcon name={link.icon} />
                <span class="hero-link__label">{link.label}</span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </div>
  <div class:list={["hero-bio", "bio", ...bioClass]}>
    <slot />
  </div>
</section>

<script is:inline>
  // Lays out the profile links in rows that hold the same number of links,
  // with at most one fewer in the last, and as many per row as fit the card:
  // six links go 3 + 3 or 2 + 2 + 2, never 4 + 2 or 2, 1, 2, 1.
  //   pills: equal-width cells in a grid of that many columns.
  //   text, text-icons: rows at their natural widths, with each break pinned
  //     by a <br> and the "·" that would end a line dropped.
  // Measured, not hard-coded per breakpoint, so it holds for any labels,
  // sizes, or card width. Inline so the layout is in place before the first
  // paint; without it, links wrap where they fall and every dot shows.
  (() => {
    const navs = document.querySelectorAll(".hero-links");

    const layout = (nav) => {
      const style = getComputedStyle(nav);
      const kind = style.getPropertyValue("--hero-links-layout").trim();
      if (kind !== "pills") delete nav.dataset.cols;
      nav.querySelectorAll("br[data-hero-break]").forEach((br) => br.remove());
      nav.querySelectorAll("[data-line-end]").forEach((link) => link.removeAttribute("data-line-end"));
      const links = [...nav.querySelectorAll(".hero-link")];
      if (kind === "pills") layoutPills(nav, style, links);
      if (kind === "text") layoutText(nav, links);
    };

    // The most links per row such that rows are balanced and `fits` holds.
    const perRow = (count, fits) => {
      for (let c = count; c > 1; c -= 1) {
        const balanced = count % c === 0 || count % c >= c - 1;
        if (balanced && fits(c)) return c;
      }
      return 1;
    };

    const layoutPills = (nav, style, links) => {
      const px = (name) => parseFloat(style.getPropertyValue(name)) || 0;
      const gap = parseFloat(style.columnGap) || 0;
      const spacing = px("--hero-pill-pad-start") + px("--hero-pill-gap-min") + px("--hero-pill-pad-min");
      const text = document.createRange();
      let need = 0;
      for (const link of links) {
        // The label's text at its natural width (labels don't wrap), not its
        // box, which in the grid is whatever space the pill leaves it.
        text.selectNodeContents(link.lastElementChild);
        const content = link.firstElementChild.getBoundingClientRect().width + text.getBoundingClientRect().width;
        const linkStyle = getComputedStyle(link);
        const borders = parseFloat(linkStyle.borderLeftWidth) + parseFloat(linkStyle.borderRightWidth);
        need = Math.max(need, content + borders + spacing);
      }
      const room = nav.parentElement.clientWidth;
      const cols = perRow(links.length, (c) => c * need + (c - 1) * gap <= room);
      nav.style.setProperty("--hero-link-cols", String(cols));
      nav.dataset.cols = String(cols);
    };

    const layoutText = (nav, links) => {
      if (links.length < 2) return;
      const widths = links.map((link) => link.getBoundingClientRect().width);
      // How much a link narrows when its trailing dot is dropped.
      links[0].setAttribute("data-line-end", "");
      const dot = widths[0] - links[0].getBoundingClientRect().width;
      links[0].removeAttribute("data-line-end");
      const rowWidth = (start, end) => {
        let width = 0;
        for (let i = start; i < end; i += 1) {
          const endsLine = i === end - 1 && i < links.length - 1;
          const min = parseFloat(getComputedStyle(links[i]).minWidth) || 0;
          width += endsLine ? Math.max(min, widths[i] - dot) : widths[i];
        }
        return width;
      };
      const room = nav.clientWidth;
      const cols = perRow(links.length, (c) => {
        for (let i = 0; i < links.length; i += c) {
          if (rowWidth(i, Math.min(i + c, links.length)) > room) return false;
        }
        return true;
      });
      for (let i = cols - 1; i < links.length - 1; i += cols) {
        links[i].setAttribute("data-line-end", "");
        const br = document.createElement("br");
        br.dataset.heroBreak = "";
        links[i].after(br);
      }
    };

    const layoutAll = () => navs.forEach(layout);
    layoutAll();
    // Web fonts change label widths; the card's width changes across
    // breakpoints, which also switch link styles and sizes.
    document.fonts?.ready.then(layoutAll);
    if ("ResizeObserver" in window) {
      const observer = new ResizeObserver(layoutAll);
      navs.forEach((nav) => observer.observe(nav.parentElement));
    } else {
      window.addEventListener("resize", layoutAll, { passive: true });
    }
  })();
</script>
